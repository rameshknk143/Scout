[Unit]
Description=Push new scrape rows to ScoutVeda
After=network-online.target
Wants=network-online.target
OnFailure=scout-alert@%N.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/scoutd
Environment=PYTHONPATH=/home/ubuntu/scoutd
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/.config/scoutd/env
ExecStart=/usr/bin/python3 -m scoutd.run push

# A push is a few HTTP requests. The only slow case is a Render cold start,
# which push_to_scoutveda.py already allows 90s for per request.
TimeoutStartSec=15min
MemoryAccounting=yes
MemoryMax=250M
Nice=10
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
