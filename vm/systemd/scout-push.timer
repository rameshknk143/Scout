[Unit]
Description=Push scrape rows to ScoutVeda hourly

[Timer]
# Hourly, not just after a scrape. The push is a no-op when there is nothing
# new, so this costs one cheap check -- and in exchange a missed tick, a Render
# cold start or a failed send all self-heal within the hour instead of waiting
# twelve hours for the next scrape.
OnCalendar=*-*-* *:35:00
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
