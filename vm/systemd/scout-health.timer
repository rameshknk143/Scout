[Unit]
Description=Run the ScoutVeda watchdog every 15 minutes

[Timer]
OnCalendar=*-*-* *:00/15:00

# Two minutes after boot as well. A reboot is the single most likely moment for
# something to come back wrong, and this makes the first heartbeat after one
# arrive promptly rather than up to 15 minutes later -- which is the difference
# between a reboot that confirms itself and one that looks like an outage.
OnBootSec=2min

# The dead-man's switch depends on these heartbeats being recent, so a missed
# window is worth making up immediately.
Persistent=true

[Install]
WantedBy=timers.target
