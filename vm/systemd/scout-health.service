[Unit]
Description=ScoutVeda VM watchdog and self-healing checks
After=network-online.target
Wants=network-online.target
OnFailure=scout-alert@%N.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/scoutd
Environment=PYTHONPATH=/home/ubuntu/scoutd
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/.config/scoutd/env
ExecStart=/usr/bin/python3 -m scoutd.run health
TimeoutStartSec=8min
MemoryAccounting=yes
MemoryMax=200M
Nice=10

# NOT PrivateTmp. This unit reaps orphaned browser processes and inspects the
# real /tmp; a private namespace would hide exactly what it is looking for.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no

[Install]
WantedBy=multi-user.target
