# ScoutVeda Maxun Configuration
# Generated: 2026-09-24
# Get your API key from http://localhost:5173 → Settings → API Keys

MAXUN_API_URL=http://127.0.0.1:8080

# Get this from Maxun UI: Settings → API Keys → Generate New Key
# OR use an existing key if you have one
MAXUN_API_KEY=YOUR_MAXUN_API_KEY_HERE

# Robot IDs (get from Maxun UI after creating robots)
# Format: ROBOT_ID=Category_Name
# Example: MAXUN_ROBOT_ID=ecdadb40-e182-4ecf-a9cb-f076c21ec240
MAXUN_ROBOT_ID=ecdadb40-e182-4ecf-a9cb-f076c21ec240

# Multi-category mode (optional, leave blank for single robot)
# Format: ID1=Category1;ID2=Category2;...
MAXUN_ROBOTS=

# ScoutVeda integration
SCOUT_API_URL=https://scout-api-3yvy.onrender.com
SCOUT_API_KEY=VnILAeDCQ2PvtPb067tqmdhGz0

# Trigger settings
TRIGGER_EVERY_HOURS=1

# Default category (used when no robot-specific category)
SCOUT_CATEGORY=Beauty & Personal Care
SCOUT_LIST_TYPE=bestsellers
